# Copy to `.env` and fill in. Never commit the real `.env`.

# vLLM / OpenAI-compatible endpoint that serves Qwen3-30B-A3B
# (used for dataset generation and the LLM-as-a-judge adjudicator).
# Start one locally, e.g.:
#   vllm serve Qwen/Qwen3-30B-A3B --port 8000 --host 0.0.0.0 --max-model-len 4096
VLLM_BASE_URL="http://localhost:8000/v1"
OPENAI_API_KEY="EMPTY"

# Model id served at the endpoint above (must match `vllm serve` model name).
ADJUDICATOR_MODEL="Qwen/Qwen3-30B-A3B"

# Only needed if you push your own dataset/model copies to the Hub.
# HF_TOKEN=""
